{
  "name": "fleetguard-console",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Company-owned device management console (static reference implementation for GitHub Pages)",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run build && wrangler dev --var PUBLIC_URL:http://127.0.0.1:8787 --var INSECURE_DEV_COOKIES:true --var BOOTSTRAP_TOKEN:local-dev-bootstrap-token",
    "build": "tsc -p . && vite build && node scripts/embed-assets.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "node scripts/embed-assets.mjs --if-missing && tsc -p . && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/run.mjs",
    "test:e2e:server": "node e2e/server.mjs",
    "android": "cd android && ./gradlew :agent:testDebugUnitTest :agent:assembleRelease :console:assembleRelease",
    "deploy": "npm run build && wrangler deploy",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e && npm run test:e2e:server"
  },
  "dependencies": {
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "hono": "^4.13.16",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=20"
  }
}
